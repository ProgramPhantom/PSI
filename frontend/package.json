{
	"name": "tstest",
	"private": true,
	"version": "0.0.0",
	"homepage": "https://ProgramPhantom.github.io/PSI",
	"type": "module",
	"prettier": {
		"arrowParens": "always",
		"bracketSameLine": true,
		"objectWrap": "preserve",
		"bracketSpacing": false,
		"semi": true,
		"experimentalOperatorPosition": "start",
		"experimentalTernaries": false,
		"singleQuote": false,
		"jsxSingleQuote": false,
		"quoteProps": "as-needed",
		"trailingComma": "none",
		"singleAttributePerLine": false,
		"htmlWhitespaceSensitivity": "css",
		"vueIndentScriptAndStyle": false,
		"proseWrap": "preserve",
		"insertPragma": false,
		"requirePragma": false,
		"tabWidth": 4,
		"useTabs": true,
		"embeddedLanguageFormatting": "auto",
		"cursorOffset": -1,
		"printWidth": 100
	},
	"scripts": {
		"predeploy": "npm run build",
		"deploy": "gh-pages -d dist",
		"dev": "vite",
		"build": "tsc && vite build && npm run build --prefix ../docs && node scripts/copy-wiki.js",
		"docs:dev": "npm start --prefix ../docs",
		"docs:build": "npm run build --prefix ../docs",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"preview": "vite preview"
	},
	"dependencies": {
		"@blueprintjs/core": "^5.10.1",
		"@dnd-kit/core": "^6.1.0",
		"@dnd-kit/sortable": "^8.0.0",
		"@react-oauth/google": "^0.13.4",
		"@reduxjs/toolkit": "^2.8.2",
		"@svgdotjs/svg.draggable.js": "^3.0.5",
		"@svgdotjs/svg.js": "^3.2.4",
		"better-react-mathjax": "^2.0.3",
		"chart.js": "^4.5.1",
		"dompurify": "^3.3.3",
		"file-saver": "^2.0.5",
		"js-sha256": "^0.11.1",
		"jszip": "^3.10.1",
		"localforage": "^1.10.0",
		"rbush": "^4.0.1",
		"react": "^18.2.0",
		"react-dnd": "^16.0.1",
		"react-dnd-html5-backend": "^16.0.1",
		"react-dom": "^18.2.0",
		"react-hook-form": "^7.51.3",
		"react-inspector": "^6.0.2",
		"react-redux": "^9.2.0",
		"react-zoom-pan-pinch": "^3.6.1",
		"redux-persist": "^6.0.0",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@types/dompurify": "^3.0.5",
		"@types/file-saver": "^2.0.7",
		"@types/node": "^20.11.10",
		"@types/rbush": "^4.0.0",
		"@types/react": "^18.2.48",
		"@types/react-dom": "^18.2.18",
		"@typescript-eslint/eslint-plugin": "^6.14.0",
		"@typescript-eslint/parser": "^6.14.0",
		"@vitejs/plugin-react": "^4.2.1",
		"dependency-cruiser": "^17.2.0",
		"dpdm": "^3.14.0",
		"eslint": "^8.55.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react-hooks": "^4.6.0",
		"eslint-plugin-react-refresh": "^0.4.5",
		"gh-pages": "^6.3.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "3.6.2",
		"sass": "^1.100.0",
		"typescript": "^5.5.3",
		"vite": "^5.4.19",
		"vite-plugin-circular-dependency": "^0.5.0"
	}
}